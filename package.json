{
  "name": "dsh-migrate",
  "version": "1.3.0",
  "description": "Migrate a DSH profile to another machine: pack installed plugins + memory snapshot, generate an installer that verifies the target, installs plugins, merges memory and restarts DSH with confirmation. Forked from dsh-memory-sync (MIT, QIC-9821).",
  "type": "module",
  "license": "MIT",
  "author": "欧鲸鲸 / 马斯他",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "migrate",
    "backup",
    "memory",
    "sync"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}